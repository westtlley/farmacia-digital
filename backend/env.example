PORT=10000
FRONTEND_URL=http://localhost:5173
NODE_ENV=production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/farmacia_digital
DB_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Admin inicial do painel.
# Em producao, defina valores reais e fortes.
ADMIN_EMAIL=admin@farmacia.com
ADMIN_PASSWORD=troque-esta-senha-forte
AUTH_SESSION_TTL_HOURS=24
AUTH_COOKIE_NAME=farmacia_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Storage profissional de receitas (S3 compatível)
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=farmacia-receitas
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# Redis distribuído
REDIS_URL=redis://localhost:6379
REDIS_RETRY_AFTER_FAILURE_MS=15000

# Monitoramento
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Logging
LOG_HTTP_REQUESTS=false

# Hardening e limites operacionais
ENABLE_API_CSP=true
MAX_PRESCRIPTION_UPLOAD_BYTES=10485760
RATE_LIMIT_LOGIN_WINDOW_MS=300000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_PRESCRIPTION_UPLOAD_WINDOW_MS=600000
RATE_LIMIT_PRESCRIPTION_UPLOAD_MAX=8
RATE_LIMIT_ORDER_WINDOW_MS=300000
RATE_LIMIT_ORDER_MAX=12
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=60
